# =============================================================================
# Hearthlog — .gitignore
#
# This repository is public, so the rule below the line about secrets is not a
# tidiness preference. Bots scrape GitHub for connection strings continuously;
# a committed Atlas URI is typically found and abused within minutes, and the
# history keeps it readable even after a later "remove secrets" commit.
#
# Everything a judge or a deployment needs IS committed: all source, both
# package-lock.json files, the .env.example templates, and the deploy configs.
# =============================================================================


# --- Secrets. Never commit. --------------------------------------------------
# The templates (backend/.env.example, frontend/.env.example) are committed and
# document every variable; the filled-in files stay local.
.env
.env.*
!.env.example
!.env.template

# The Atlas onboarding file — contains a live username and password.
atlas-credentials.env
*credentials*.env

# Keys and certificates, in case any ever land here.
*.pem
*.key
*.p12
*.pfx
id_rsa*
serviceAccountKey.json


# --- Dependencies ------------------------------------------------------------
# ~76 MB across the two packages, and fully reproducible from the committed
# lockfiles with `npm install`. Hosts run that themselves.
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases


# --- Build output ------------------------------------------------------------
# Vercel, Netlify and Render all run the build themselves; committing dist/
# only creates merge conflicts and stale bundles.
dist/
dist-ssr/
build/
out/
.vite/
*.local


# --- Logs and runtime junk ---------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.server.log
.server.err.log
pids/
*.pid
*.seed


# --- Test and coverage output ------------------------------------------------
coverage/
.nyc_output/
*.lcov


# --- Caches ------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.node_repl_history


# --- Editors and IDEs --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-workspace
*~


# --- Operating system --------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# --- Deployment platforms ----------------------------------------------------
.vercel
.netlify
.now


# --- Local agent tooling -----------------------------------------------------
# Editor launch config for this machine; of no use to anyone cloning the repo.
# Delete this line if you would rather ship it.
.claude/
