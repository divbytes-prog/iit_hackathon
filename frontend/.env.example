# ---------------------------------------------------------------------------
# Hearthlog web — environment template
# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.
# ---------------------------------------------------------------------------

# Base URL of the Hearthlog API. Leave as-is for local development;
# point at your deployed API (e.g. https://hearthlog-api.onrender.com/api/v1)
# in production.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Public site URL, used for canonical + Open Graph tags.
VITE_SITE_URL=http://localhost:5173
