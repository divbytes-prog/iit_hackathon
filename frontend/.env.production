# ---------------------------------------------------------------------------
# Production build values. Committed on purpose: Vite inlines every VITE_*
# variable into the public bundle, so nothing secret can live here by
# definition — these are the same strings anyone can read in the shipped JS.
#
# The API base is *relative*. In production, vercel.json rewrites /api/* to the
# hearthlog-api deployment, so the browser only ever talks to its own origin:
# no CORS preflights, and the session cookie stays first-party (third-party
# cookie blocking would otherwise break token refresh).
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=/api/v1
