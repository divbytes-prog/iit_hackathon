# ---------------------------------------------------------------------------
# Hearthlog API — environment template
# Copy to `.env` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/...)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hearthlog

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_TTL_MS=2592000000

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Set to true when running behind a proxy (Render, Railway, Fly, Heroku)
TRUST_PROXY=false

# Optional: cookie domain for cross-subdomain auth
COOKIE_DOMAIN=
